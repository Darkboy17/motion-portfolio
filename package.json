{
  "name": "motion-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Code-based 2D motion graphics and animated explainers, built with Remotion, React and TypeScript.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "lint": "eslint src scripts && tsc --noEmit",
    "test": "vitest run",
    "assets": "tsx scripts/make-sfx.ts && tsx scripts/make-lottie.ts",
    "render": "tsx scripts/render.ts",
    "stills": "tsx scripts/render.ts --stills",
    "showreel": "tsx scripts/showreel.ts",
    "site": "tsx scripts/build-site.ts",
    "sfx:fetch": "tsx scripts/fetch-sfx-sources.ts",
    "sfx:prepare": "tsx scripts/prepare-sfx.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/lottie": "4.0.484",
    "@remotion/paths": "4.0.484",
    "lottie-web": "^5.13.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "4.0.484",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.484",
    "@types/node": "^22.20.7",
    "@types/react": "^19.2.7",
    "eslint": "^9.19.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
